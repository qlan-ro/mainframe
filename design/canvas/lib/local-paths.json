{
  "about": "What a local path looks like, read by lib/boards.py (before a board is written) and tools/check.mjs (on committed files). Keep all of it to the regex syntax Python and JavaScript share. `paths` are joined with |. The text is searched with `encoded` characters decoded, and so is what each `base64` run holds, with the line breaks of a wrapped one (`wrap`) taken out.",
  "paths": [
    "(?<![\\w.-])/Users/",
    "\\bfile://[\\w.-]+/Users/",
    "/Volumes/[^/\\s\\\"'<>]+/Users/",
    "/System/Volumes/Data/Users/",
    "/Users/(?=[\\w.-]+/(?:Documents|Desktop|Downloads|Library|Movies|Music|Pictures|Code|Projects?|Developer|\\.\\w))",
    "/private/(?:tmp|var|etc)\\b",
    "(?<![\\w.-])/(?:private|home)/",
    "/var/folders/",
    "\\b[A-Za-z]:[\\\\/]+Users[\\\\/]",
    "\\\\Users\\\\+(?=\\w)",
    "(?<![\\w./~-])Users/(?=[\\w.-]+/)",
    "(?<![\\w./~-])home/(?!(?:components|hooks|pages|api|src|assets|lib|utils|features)/)(?=[\\w.-]+/\\w)",
    "(?<![\\w./~-])(?:private/(?:tmp|var/folders)|var/folders)/(?=\\w)",
    "/tmp/claude-\\d",
    "/tmp/[^\\s\\\"'<>&;)]*-(?:Users|home)-",
    "(?<!\\w)[a-z0-9_.]*-+Users-(?!(?:per|and|or|of|in|by|to|for|with|only|page|list|table|menu|count|limit)\\b)(?=\\w)",
    "-Users-(?!(?:per|and|or|of|in|by|to|for|with|only|page|list|table|menu|count|limit)\\b)(?=[\\w.]+-\\w)",
    "(?<!\\w)-home-(?!(?:page|screen|button|icon|card|tab|link|view|nav|header|hero|menu|panel|section|row|title|dir|path|indicator|x)\\b)(?=\\w)",
    "(?<![\\w-])-(?:private-tmp|private-var|var-folders)-(?=\\w)",
    "-private-tmp-(?=\\w)",
    "-(?:private-)?var-folders-(?=[\\w.]+-\\w)"
  ],
  "end": "[^\\s\"'<>&;)]*",
  "encoded": "(?:%(?:25)*|\\\\u00|\\\\x)([2-7][0-9a-fA-F])|(?:&#[xX]0*|\\\\u\\{0*)([2-7][0-9a-fA-F])(?![0-9a-fA-F])[;}]?|&#0*([0-9]{2,3})(?![0-9]);?|\\\\0{0,2}([01][0-7]{2})(?![0-7])|(&sol;|\\\\/)|(&bsol;)",
  "base64": "[A-Za-z0-9+/_-]{12,}",
  "wrap": "(?<=[A-Za-z0-9+/_-]{16})(?:\\\\[rn]|\\s)+(?=[A-Za-z0-9+/_-])"
}
